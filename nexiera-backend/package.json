{
  "name": "nexiera-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "npm run db:deploy && node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prisma:generate": "prisma generate",
    "db:deploy": "npx prisma migrate deploy",
    "prisma:seed:demo": "tsc --ignoreConfig prisma/seed-demo-budi.ts --outDir dist/demo-seed --module NodeNext --moduleResolution NodeNext --target ES2023 --esModuleInterop --types node --skipLibCheck && node dist/demo-seed/prisma/seed-demo-budi.js",
    "prisma:seed:demo-sessions": "tsc --ignoreConfig prisma/seed-demo-class-sessions.ts prisma/demo-class-sessions.ts --outDir dist/demo-sessions --module NodeNext --moduleResolution NodeNext --target ES2023 --esModuleInterop --types node --skipLibCheck && node dist/demo-sessions/prisma/seed-demo-class-sessions.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "file-type": "^22.2.0",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
