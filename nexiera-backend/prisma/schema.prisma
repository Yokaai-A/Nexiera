generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  MAHASISWA
  PEER_TUTOR
  MITRA_BOOTCAMP
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum RoleApplicationType {
  PEER_TUTOR
  MITRA_BOOTCAMP
}

enum RoleApplicationStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum PrivateUploadPurpose {
  STUDENT_PROOF
  REPORT_EVIDENCE
  REFUND_PROOF
}

enum RefundStatus {
  NOT_REQUESTED
  PENDING_REVIEW
  PROCESSING
  REFUNDED
  REJECTED
}

enum ReportTargetType {
  CLASS
  ORGANIZER
}

enum ClassType {
  PEER_TUTORING
  BOOTCAMP
}

enum TutorGrade {
  A
  A_MINUS
  B_PLUS
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  contactEmail            String?
  password                String?
  fullName                String
  avatarUrl               String?   @db.Text
  bannerUrl               String?   @db.Text
  headline                String?
  bio                     String?   @db.Text
  campus                  String?
  major                   String?
  studentNumber           String?
  semester                String?
  organizationName        String?
  organizationLogoUrl     String?   @db.Text
  organizationWebsiteUrl  String?   @db.Text
  bootcampStudentProofUrl String?   @db.Text
  location                String?
  tutorGpa                Decimal?  @db.Decimal(3, 2)
  tutorTranscriptUrl      String?   @db.Text
  roles                   Json      @default("[\"MAHASISWA\"]")
  activeRole              Role      @default(MAHASISWA)
  phoneNumber             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  emailVerifiedAt         DateTime? @db.DateTime(3)

  classesCreated          Class[]                  @relation("CreatedClasses")
  transactions            Transaction[]
  reviews                 Review[]
  reports                 ClassReport[]
  notifications           Notification[]
  bootcampTutors          BootcampTutor[]          @relation("UserTutor")
  ads                     Ad[]
  roleApplications        RoleApplication[]
  privateUploads          PrivateUpload[]
  emailVerificationTokens EmailVerificationToken[]
  courseRequests          CourseRequest[]

  @@map("users")
}

model Class {
  id               String      @id @default(uuid())
  title            String
  slug             String      @unique
  description      String      @db.Text
  shortDescription String?     @db.Text
  type             ClassType   @default(PEER_TUTORING)
  tutorGrade       TutorGrade?
  price            Decimal     @default(0.00) @db.Decimal(12, 2)
  category         String
  major            String?
  campusTarget     String?
  bannerUrl        String?     @db.Text
  startsAt         DateTime?   @db.DateTime(3)
  accessDuration   String?     @db.VarChar(191)
  accessUntil      DateTime?   @db.DateTime(3)
  maxQuota         Int?
  meetingPlatform  String?     @db.VarChar(191)
  meetingLink      String?     @db.Text
  materialPlatform String?     @db.VarChar(191)
  materialLink     String?     @db.Text
  recordingLink    String?     @db.Text
  requirements     Json?
  facilities       Json?
  reviewStatus     String      @default("APPROVED") @db.VarChar(32)
  reviewNote       String?     @db.Text
  reviewedById     String?
  reviewedAt       DateTime?   @db.DateTime(3)
  creatorId        String
  creator          User        @relation("CreatedClasses", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tutors       BootcampTutor[]
  transactions Transaction[]
  reviews      Review[]
  reports      ClassReport[]

  @@index([startsAt])
  @@index([reviewStatus, createdAt])
  @@map("classes")
}

model BootcampTutor {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("UserTutor", fields: [userId], references: [id], onDelete: SetNull)
  name        String
  roleTitle   String
  avatarUrl   String?  @db.Text
  headline    String?
  linkedinUrl String?  @db.Text
  createdAt   DateTime @default(now())

  @@map("bootcamp_tutors")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  reply     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, classId])
  @@map("reviews")
}

model Transaction {
  id                  String            @id @default(uuid())
  orderId             String            @unique
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId             String
  class               Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  amount              Decimal           @db.Decimal(12, 2)
  status              TransactionStatus @default(PENDING)
  refundStatus        RefundStatus      @default(NOT_REQUESTED)
  refundMethod        String?
  refundAccountName   String?
  refundAccountNumber String?
  refundRequestedAt   DateTime?         @db.DateTime(3)
  refundedAt          DateTime?         @db.DateTime(3)
  refundProofUrl      String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("transactions")
}

model RoleApplication {
  id               String                @id @default(uuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             RoleApplicationType
  status           RoleApplicationStatus @default(PENDING_VERIFICATION)
  campus           String?
  major            String?
  studentProofUrl  String                @db.Text
  organizationName String?
  contactEmail     String?
  logoUrl          String?               @db.Text
  websiteUrl       String?               @db.Text
  description      String?               @db.Text
  reviewNote       String?               @db.Text
  reviewedById     String?
  reviewedAt       DateTime?             @db.DateTime(3)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([userId, type])
  @@index([status, createdAt])
  @@map("role_applications")
}

model PrivateUpload {
  id        String               @id @default(uuid())
  filename  String               @unique
  ownerId   String
  owner     User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose   PrivateUploadPurpose
  createdAt DateTime             @default(now())

  @@index([ownerId, purpose, createdAt])
  @@map("private_uploads")
}

model ClassReport {
  id          String           @id @default(uuid())
  reporterId  String
  reporter    User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  ReportTargetType
  targetId    String
  classId     String?
  class       Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  category    String           @db.VarChar(64)
  description String           @db.Text
  evidenceUrl String?          @db.Text
  status      String           @default("PENDING_REVIEW") @db.VarChar(32)
  adminNote   String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([targetType, targetId, status])
  @@index([reporterId, createdAt])
  @@map("ClassReport")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.DateTime(3)
  consumedAt DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

model CourseRequest {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(160)
  campus     String?  @db.VarChar(160)
  major      String?  @db.VarChar(160)
  courseCode String?  @db.VarChar(64)
  note       String?  @db.Text
  status     String   @default("PENDING") @db.VarChar(32)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("course_requests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  linkUrl   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Ad {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?  @db.Text
  placement   String   @default("HOME_HERO")
  imageUrl    String   @db.Text
  targetUrl   String   @db.Text
  startsAt    DateTime @default(now())
  endsAt      DateTime
  status      String   @default("PENDING_REVIEW")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ads")
}
